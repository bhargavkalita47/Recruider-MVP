{
  "name": "recruider",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "demo": "vite build --configLoader native --mode demo --outDir demo-dist && vite preview --configLoader native --outDir demo-dist --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run test && npm run build",
    "setup": "node scripts/setup.mjs",
    "test:auth": "node scripts/test-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
